{
  "name": "clawhermes-electrobun-control",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Electrobun + Vue + Vite control shell for ClawHermes USB.",
  "scripts": {
    "build:web": "vite build",
    "dev": "vite build && node ./node_modules/electrobun/bin/electrobun.cjs dev --watch",
    "start": "vite build && node ./node_modules/electrobun/bin/electrobun.cjs dev",
    "build:win": "vite build && node ./node_modules/electrobun/bin/electrobun.cjs build --env=canary --platform=win",
    "build:mac": "vite build && node ./node_modules/electrobun/bin/electrobun.cjs build --env=canary --platform=mac",
    "build:mac:arm64": "vite build && node ./node_modules/electrobun/bin/electrobun.cjs build --env=canary --platform=mac --arch=arm64",
    "build:mac:x64": "vite build && node ./node_modules/electrobun/bin/electrobun.cjs build --env=canary --platform=mac --arch=x64",
    "typecheck": "vue-tsc --noEmit --skipLibCheck"
  },
  "dependencies": {
    "electrobun": "1.16.0"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/node": "^22.10.2",
    "@types/three": "^0.184.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "typescript": "^5.7.2",
    "vite": "^6.0.3",
    "vue": "^3.5.13",
    "vue-tsc": "^2.2.0"
  }
}

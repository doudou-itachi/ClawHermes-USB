{
  "id": "hermes-agent",
  "displayName": "Hermes Agent",
  "description": "Hermes Agent gateway/API runtime.",
  "type": "python-service",
  "enabled": true,
  "appDir": "apps/hermes-agent",
  "runtime": {
    "kind": "python",
    "platform": "windows",
    "requiredExecutable": "python.exe"
  },
  "upstream": {
    "name": "NousResearch/hermes-agent",
    "repositoryUrl": "https://github.com/NousResearch/hermes-agent",
    "installDocs": "https://hermes-agent.org/",
    "checkoutRef": "main",
    "installMode": "source-checkout",
    "notes": "Official README says native Windows is not supported and Windows users should run Hermes Agent in WSL2."
  },
  "commands": {
    "setup": "python -m pip install -e .",
    "start": "hermes gateway run",
    "stop": null
  },
  "env": {
    "files": [
      "config/env/hermes.env"
    ],
    "variables": {
      "HERMES_HOME": "${USB_ROOT}/data/hermes",
      "HOME": "${USB_ROOT}/data/home",
      "USERPROFILE": "${USB_ROOT}/data/home"
    }
  },
  "dataDir": "data/hermes",
  "logFile": "data/logs/hermes-agent.log",
  "pidFile": "data/tmp/pids/hermes-agent.pid",
  "health": {
    "type": "http",
    "url": "http://127.0.0.1:8642/health",
    "timeoutSeconds": 30
  },
  "portal": {
    "label": "Hermes Agent API",
    "url": "http://127.0.0.1:8642",
    "group": "Hermes"
  },
  "integration": {
    "status": "blocked",
    "productionReady": false,
    "verifiedAt": "2026-05-01",
    "summary": "Official README says native Windows is not supported and Windows users should install WSL2. Official site also describes native Windows as experimental, so the bare-Windows portable adapter remains blocked.",
    "sources": [
      "https://hermes-agent.org/",
      "https://github.com/NousResearch/hermes-agent"
    ]
  },
  "dependsOn": []
}

{
  "id": "hermes-agent",
  "displayName": "Hermes Agent",
  "description": "Hermes Agent gateway/API runtime.",
  "type": "python-service",
  "enabled": true,
  "appDir": "apps/hermes-agent",
  "runtime": {
    "kind": "wsl2",
    "platform": "windows",
    "requiredExecutable": "wsl.exe",
    "distro": "ClawHermes-Ubuntu",
    "sourceDistro": "Ubuntu"
  },
  "upstream": {
    "name": "NousResearch/hermes-agent",
    "repositoryUrl": "https://github.com/NousResearch/hermes-agent",
    "installDocs": "https://hermes-agent.org/",
    "checkoutRef": "main",
    "installMode": "source-checkout",
    "notes": "Official README says native Windows is not supported and Windows users should run Hermes Agent in WSL2."
  },
  "commands": {
    "setup": "tmp=$(mktemp) && sed 's/\\r$//' ./setup-hermes.sh > \"$tmp\" && printf 'n\\nn\\n' | bash \"$tmp\"; rc=$?; rm -f \"$tmp\"; exit $rc",
    "start": "./venv/bin/hermes gateway run",
    "stop": "pkill -TERM -f './venv/bin/hermes gateway run' || pkill -TERM -f 'hermes gateway run' || true"
  },
  "env": {
    "files": [
      "config/env/hermes.env"
    ],
    "variables": {
      "HERMES_HOME": "${USB_ROOT}/data/hermes",
      "API_SERVER_KEY": "clawhermes",
      "HOME": "${USB_ROOT}/data/home",
      "USERPROFILE": "${USB_ROOT}/data/home"
    }
  },
  "dataDir": "data/hermes",
  "logFile": "data/logs/hermes-agent.log",
  "pidFile": "data/tmp/pids/hermes-agent.pid",
  "health": {
    "type": "http",
    "url": "http://127.0.0.1:8642/health",
    "timeoutSeconds": 30
  },
  "portal": {
    "label": "Hermes Agent API",
    "url": "http://127.0.0.1:8642",
    "group": "Hermes"
  },
  "integration": {
    "status": "verified",
    "productionReady": true,
    "verifiedAt": "2026-05-01",
    "summary": "Verified on 2026-05-01 in project-managed ClawHermes-Ubuntu WSL2: setup-adapter completed, start-adapter launched ./venv/bin/hermes gateway run, and http://127.0.0.1:8642/health returned 200.",
    "platform": "wsl2",
    "strategy": "wsl2-adapter",
    "sources": [
      "https://hermes-agent.org/",
      "https://github.com/NousResearch/hermes-agent"
    ]
  },
  "dependsOn": []
}

{
  "id": "openclaw",
  "displayName": "OpenClaw",
  "description": "Official OpenClaw runtime, Control UI, and WebChat integration.",
  "type": "custom",
  "enabled": true,
  "appDir": "apps/openclaw",
  "runtime": {
    "kind": "wsl2",
    "platform": "windows",
    "requiredExecutable": "wsl.exe",
    "distro": "Ubuntu"
  },
  "upstream": {
    "name": "openclaw/openclaw",
    "repositoryUrl": "https://github.com/openclaw/openclaw",
    "installDocs": "https://docs.openclaw.ai/platforms/windows",
    "checkoutRef": "main",
    "installMode": "source-checkout",
    "notes": "Official Windows docs recommend WSL2 for the full experience; native Windows remains a caveated path."
  },
  "commands": {
    "setup": null,
    "start": null,
    "stop": null
  },
  "env": {
    "files": [
      "config/env/openclaw.env"
    ],
    "variables": {
      "HOME": "${USB_ROOT}/data/home",
      "USERPROFILE": "${USB_ROOT}/data/home",
      "OPENCLAW_HOME": "${USB_ROOT}/data/openclaw",
      "OPENCLAW_DATA_DIR": "${USB_ROOT}/data/openclaw"
    }
  },
  "dataDir": "data/openclaw",
  "logFile": "data/logs/openclaw.log",
  "pidFile": "data/tmp/pids/openclaw.pid",
  "health": {
    "type": "process",
    "timeoutSeconds": 30
  },
  "portal": {
    "label": "OpenClaw",
    "url": null,
    "group": "OpenClaw"
  },
  "integration": {
    "status": "blocked",
    "productionReady": false,
    "verifiedAt": "2026-05-01",
    "summary": "Official Windows guidance says WSL2 is the more stable and recommended path for the full experience. Native Windows gateway use exists but has service-install caveats, so OpenClaw remains blocked until WSL2 data path, gateway port, and UI behavior are verified from an installed payload.",
    "platform": "wsl2",
    "strategy": "wsl2-adapter",
    "sources": [
      "https://docs.openclaw.ai/platforms/windows",
      "https://docs.openclaw.kr/cli/gateway"
    ]
  },
  "dependsOn": []
}

{
  "id": "openclaw",
  "displayName": "OpenClaw",
  "description": "Official OpenClaw runtime, Control UI, and WebChat integration.",
  "type": "custom",
  "enabled": true,
  "appDir": "apps/openclaw",
  "runtime": {
    "kind": "node",
    "platform": "windows",
    "requiredExecutable": "node.exe"
  },
  "upstream": {
    "name": "openclaw/openclaw",
    "repositoryUrl": "https://github.com/openclaw/openclaw",
    "installDocs": "https://github.com/openclaw/openclaw/blob/main/docs/platforms/windows.md",
    "checkoutRef": "main",
    "installMode": "source-checkout",
    "notes": "Native portable Windows startup remains blocked pending upstream Windows data path verification."
  },
  "commands": {
    "setup": null,
    "start": null,
    "stop": null
  },
  "env": {
    "files": [
      "config/env/openclaw.env"
    ],
    "variables": {
      "HOME": "${USB_ROOT}/data/home",
      "USERPROFILE": "${USB_ROOT}/data/home",
      "OPENCLAW_HOME": "${USB_ROOT}/data/openclaw",
      "OPENCLAW_DATA_DIR": "${USB_ROOT}/data/openclaw"
    }
  },
  "dataDir": "data/openclaw",
  "logFile": "data/logs/openclaw.log",
  "pidFile": "data/tmp/pids/openclaw.pid",
  "health": {
    "type": "process",
    "timeoutSeconds": 30
  },
  "portal": {
    "label": "OpenClaw",
    "url": null,
    "group": "OpenClaw"
  },
  "integration": {
    "status": "blocked",
    "productionReady": false,
    "verifiedAt": "2026-04-30",
    "summary": "Official Windows guidance recommends WSL2 for the full experience. Native Windows gateway use exists but has service-install caveats, so the portable native adapter is blocked until data path and port behavior are verified.",
    "sources": [
      "https://github.com/openclaw/openclaw/blob/main/docs/platforms/windows.md"
    ]
  },
  "dependsOn": []
}

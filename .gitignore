# Secrets
config/env/*.env
!config/env/*.env.example

# Runtime payloads
runtimes/windows/node/*
runtimes/windows/python/*
runtimes/windows/git/*
runtimes/macos/node/*
runtimes/macos/python/*
runtimes/macos/git/*
runtimes/wsl/*.tar
runtimes/wsl/*.tar.*

# Upstream application payloads
apps/openclaw/*
apps/hermes-agent/*
apps/hermes-web-ui/*

# Keep placeholders
!apps/openclaw/.gitkeep
!apps/hermes-agent/.gitkeep
!apps/hermes-web-ui/.gitkeep
!runtimes/windows/node/.gitkeep
!runtimes/windows/python/.gitkeep
!runtimes/windows/git/.gitkeep
!runtimes/macos/node/.gitkeep
!runtimes/macos/python/.gitkeep
!runtimes/macos/git/.gitkeep
!runtimes/wsl/.gitkeep

# Portable data
data/**
!data/
!data/**/
!data/**/.gitkeep
data/openclaw/.openclaw/
data/**/.git/
data/home/AppData/

# PyInstaller output
/ClawHermes-Control.spec
/build/
/launcher/pyqt/build/
/launcher/pyqt/dist/
/launcher/electrobun/artifacts/
/launcher/electrobun/build/
/launcher/electrobun/dist/
/launcher/electrobun/node_modules/
/dist-usb/

# OS/editor
Thumbs.db
.DS_Store
.vscode/
.idea/
node_modules/
__pycache__/
*.pyc
.superpowers/
.firecrawl/

# Generated portal output
portal/index.html
